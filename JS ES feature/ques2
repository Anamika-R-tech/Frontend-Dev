"use strict";

const employees = [
    { name: "Amit", salary: "45000", years: "5" },
    { name: "Sara", salary: "38000", years: "2" },
    { name: "Kiran", salary: "52000", years: "7" }
];

employees.forEach(emp => {
    try {
        // Convert salary and years to numbers
        const salary = Number(emp.salary);
        const years = Number(emp.years);

        if(isNaN(salary) || isNaN(years)) throw new Error("Invalid numeric conversion");
        if(!emp.name) throw new Error("Missing name property");

        // Calculate bonus
        const bonus = years > 3 ? salary * 0.1 : salary * 0.05;

        // Log formatted details
        console.log(`Employee: ${emp.name}, Salary: ₹${salary}, Years: ${years}, Bonus: ₹${bonus}`);
    } catch(error) {
        console.log(`Error processing employee ${emp.name || "Unknown"}: ${error.message}`);
    }
});


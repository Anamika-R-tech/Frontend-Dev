<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Restaurant Menu</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container my-5">
        <h2 class="text-center mb-4">Today's Menu</h2>

        <!-- Menu Table -->
        <div class="table-responsive mb-4">
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Item</th>
                        <th>Category</th>
                        <th>Price (₹)</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Margherita Pizza</td>
                        <td>Pizza</td>
                        <td>250</td>
                    </tr>
                    <tr>
                        <td>Pasta Alfredo</td>
                        <td>Pasta</td>
                        <td>180</td>
                    </tr>
                    <tr>
                        <td>Chocolate Lava Cake</td>
                        <td>Dessert</td>
                        <td>120</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Chef's Specials -->
        <h4 class="mb-3 text-center">Chef's Specials</h4>
        <ul class="list-group mb-4">
            <li class="list-group-item">Grilled Salmon with Lemon Butter</li>
            <li class="list-group-item">Truffle Mushroom Risotto</li>
            <li class="list-group-item">Stuffed Chicken Breast</li>
        </ul>

        <!-- Food Image -->
        <div class="text-center">
            <img src="https://via.placeholder.com/500x300" class="img-fluid mb-2" alt="Delicious Dish">
            <p class="lead">Try our special of the day!</p>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

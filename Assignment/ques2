let productName = " wireless headphones PRO ";

// Trim spaces and convert to lowercase
let cleaned = productName.trim().toLowerCase();

// Capitalize first letter of each word
let capitalized = cleaned.split(" ").map(word => {
    return word.charAt(0).toUpperCase() + word.slice(1);
}).join(" ");

// Replace 'pro' with 'Pro Edition'
let finalTitle = capitalized.replace("Pro", "Pro Edition");

// Display results
console.log(`Cleaned Product Title: ${finalTitle}`);
console.log(`Title Length: ${finalTitle.length}`);

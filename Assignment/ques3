let x = 16.75;

// Calculations
let rounded = Math.round(x);
let squareRoot = Math.sqrt(x);
let power = Math.pow(x, 3);
let randomNumber = Math.floor(Math.random() * 41) + 10; // 10–50

// Display results with template literals
console.log(`Math Dashboard for x = ${x}:
- Rounded Value: ${rounded}
- Square Root: ${squareRoot.toFixed(2)}
- x Cubed: ${power.toFixed(2)}
- Random Number (10–50): ${randomNumber}`);

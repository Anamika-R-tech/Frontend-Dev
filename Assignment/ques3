<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Gradient Background Page</title>
<style>
body, html {
    margin: 0;
    font-family: Arial, sans-serif;
}

header, footer {
    position: fixed;
    width: 100%;
    height: 60px;
    line-height: 60px;
    text-align: center;
    background-color: #333;
    color: white;
    z-index: 1000;
}
header { top: 0; }
footer { bottom: 0; }

section {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    color: white;
    text-align: center;
    padding: 0 20px;
}

.linear-section {
    background: linear-gradient(135deg, #ff7e5f, #feb47b);
    background-attachment: fixed; /* Parallax effect */
}

.radial-section {
    background: radial-gradient(circle at center, #6a11cb, #2575fc);
}
</style>
</head>
<body>

<header>Fixed Header</header>

<section class="linear-section">
    <h1>Linear Gradient</h1>
    <p>This section uses a linear gradient with a parallax effect.</p>
</section>

<section class="radial-section">
    <h1>Radial Gradient</h1>
    <p>This section uses a radial gradient centered in the page.</p>
</section>

<footer>Fixed Footer</footer>

</body>
</html>

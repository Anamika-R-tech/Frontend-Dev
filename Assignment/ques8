<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Feedback Form</title>
</head>
<body>

<h2>Feedback</h2>
<form method="post" action="#">
    <label>Feedback:</label><br>
    <textarea name="feedback" rows="5" required></textarea><br><br>
    
    <label>Rating:</label><br>
    <input type="radio" name="rating" value="Good" required> Good
    <input type="radio" name="rating" value="Average"> Average
    <input type="radio" name="rating" value="Poor"> Poor<br><br>
    
    <button type="submit">Submit</button>
</form>

</body>
</html>

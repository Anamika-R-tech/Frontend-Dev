//HTML
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="q3.css">
    <title>Homepage</title>
</head>
<body>

<header>
    <nav>
        <a href="#">Home</a>
        <a href="#">Services</a>
        <a href="#">Projects</a>
        <a href="#">Contact</a>
    </nav>
</header>

<main>
    <div class="box">Services</div>
    <div class="box">Projects</div>
    <div class="box">Contact</div>
</main>

<footer>
    <p>Footer Content</p>
</footer>


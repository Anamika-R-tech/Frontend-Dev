//CSS
body {
    margin: 0;
    font-family: Arial;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
}

header nav {
    display: flex;
    justify-content: space-around;
    padding: 20px;
    background: #444;
}
header nav a {
    color: white;
    text-decoration: none;
}

main {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    padding: 30px;
}

.box {
    background: #ddd;
    padding: 40px;
    flex: 1;
    text-align: center;
    transition: transform 0.3s;
}

.box:hover {
    transform: rotate(2deg);
}

footer {
    background: #333;
    color: white;
    padding: 15px;
    text-align: center;
}


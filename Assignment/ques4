<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Shadows and Depth</title>
<style>
body {
    margin: 0;
    font-family: Arial, sans-serif;
    background-color: #f5f5f5;
}

.cards-container {
    display: flex;
    justify-content: center;
    gap: 20px;
    padding: 100px 20px;
    flex-wrap: wrap;
}

.card {
    background-color: white;
    padding: 20px;
    width: 250px;
    border-radius: 15px;
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    transition: transform 0.3s, box-shadow 0.3s;
}

.card:hover {
    transform: translateY(-10px);
    box-shadow: 0 12px 20px rgba(0,0,0,0.3);
}

.card h3 {
    text-align: center;
    text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
}
</style>
</head>
<body>

<div class="cards-container">
    <div class="card">
        <h3>Card 1</h3>
        <p>Shadow and depth effect with smooth hover animation.</p>
    </div>
    <div class="card">
        <h3>Card 2</h3>
        <p>Another card demonstrating lifting shadow on hover.</p>
    </div>
    <div class="card">
        <h3>Card 3</h3>
        <p>Cards arranged in a row using Flexbox with depth effects.</p>
    </div>
</div>

</body>
</html>

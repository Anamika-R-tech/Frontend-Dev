// Select elements
const inputBox = document.getElementById("productInput");
const addBtn = document.getElementById("addBtn");
const productList = document.getElementById("productList");

let currentEditing = null;

// Add product
addBtn.addEventListener("click", () => {
    const value = inputBox.value.trim();
    if (!value) return;

    const li = document.createElement("li");
    li.innerHTML = `
        <span class="text">${value}</span>
        <button class="edit">Edit</button>
        <button class="delete">Delete</button>
    `;
    productList.appendChild(li);
    inputBox.value = "";
});

// Event Delegation for Edit/Delete
productList.addEventListener("click", (e) => {
    const target = e.target;
    const li = target.closest("li");

    // Delete
    if (target.classList.contains("delete")) {
        li.remove();
    }

    // Edit
    if (target.classList.contains("edit")) {
        const span = li.querySelector(".text");

        if (currentEditing) currentEditing.contentEditable = false;

        span.contentEditable = true;
        span.focus();
        currentEditing = span;
    }
});

// Auto-save when clicking outside
document.addEventListener("click", (e) => {
    if (currentEditing && !currentEditing.contains(e.target)) {
        currentEditing.contentEditable = false;
        currentEditing = null;
    }
});

//HTML
<input id="productInput"><button id="addBtn">Add</button>
<ul id="productList"></ul>

